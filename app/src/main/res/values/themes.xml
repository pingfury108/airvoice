<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorAccent">#3F51B5</item>
    </style>

    <style name="KeyButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#374151</item>
        <item name="android:background">@drawable/bg_key</item>
    </style>

    <style name="DpadButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#374151</item>
        <item name="android:background">@drawable/bg_key</item>
    </style>

    <style name="GuideButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#374151</item>
        <item name="android:background">@drawable/bg_card</item>
    </style>
</resources>
